{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muhabwebsites",
  "compatibility_date": "2026-10-07",
  "routes": [
    {
      "pattern": "muhab.org",
      "custom_domain": true
    },
    {
      "pattern": "www.muhab.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
